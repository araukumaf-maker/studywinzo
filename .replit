modules = ["nodejs-24", "php-8.4"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "StudyWinzo"

[[workflows.workflow]]
name = "StudyWinzo"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash studywinzo/start.sh"
waitForPort = 9000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
