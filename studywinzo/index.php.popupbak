<?php
ini_set('display_errors', 0);
error_reporting(E_ALL & ~E_DEPRECATED & ~E_WARNING & ~E_NOTICE);

// Load batches + settings from admin API (direct file read — faster)
$adminData = __DIR__.'/admin/data';
$batches = [];
$settings = ['institution_name'=>'StudyWinzo','logo'=>''];

if (file_exists($adminData.'/batches.json')) {
    $d = json_decode(file_get_contents($adminData.'/batches.json'), true);
    if (is_array($d)) $batches = $d;
}
if (file_exists($adminData.'/settings.json')) {
    $s = json_decode(file_get_contents($adminData.'/settings.json'), true);
    if (is_array($s)) $settings = array_merge($settings, $s);
}

// If admin has no batches, show default
if (empty($batches)) {
    $batches = [
        ['id'=>'default-1','name'=>'Physics Wallah','subject'=>'Physics','description'=>'Complete JEE/NEET batches','color'=>'#2cee82','image'=>''],
        ['id'=>'default-2','name'=>'Next Toppers','subject'=>'All Subjects','description'=>'Class 9-12 complete','color'=>'#2cee82','image'=>''],
        ['id'=>'default-3','name'=>'Mission JEET','subject'=>'JEE','description'=>'JEE Advanced','color'=>'#2cee82','image'=>''],
        ['id'=>'default-4','name'=>'Master Sahab','subject'=>'Foundation','description'=>'Foundation courses','color'=>'#2cee82','image'=>''],
    ];
}
$instName = $settings['institution_name'] ?? 'StudyWinzo';
$logo = $settings['logo'] ?? '';
?>
