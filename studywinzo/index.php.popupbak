<script>
function toggleDrawer(){
  var d = document.getElementById('drawer');
  var o = document.getElementById('drawer-overlay');
  var open = d.style.transform === 'translateX(0px)' || d.style.transform === 'translateX(0)';
  if(open){ d.style.transform = 'translateX(-100%)'; o.style.display='none'; }
  else { d.style.transform = 'translateX(0)'; o.style.display='block'; }
}
function openBatch(id, name){
  var html = '<div style="position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:1000;display:flex;align-items:flex-end;" onclick="if(event.target===this)closeModal()">';
  html += '<div style="background:#0a1512;border-top-left-radius:24px;border-top-right-radius:24px;padding:24px;width:100%;border-top:2px solid #2cee82;max-height:80vh;overflow-y:auto;">';
  html += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;"><h2 style="color:#fff;font-size:18px;font-weight:700;margin:0;">'+name+'</h2>';
  html += '<button onclick="closeModal()" style="background:#1f332a;border:none;color:#2cee82;width:36px;height:36px;border-radius:50%;font-size:20px;cursor:pointer;">×</button></div>';
  html += '<div style="background:#0e1f1a;border:1px solid #1f4a2f;border-radius:14px;padding:16px;margin-bottom:14px;">';
  html += '<div style="display:flex;justify-content:space-between;margin-bottom:8px;"><span style="color:#6b7a75;font-size:12px;">STATUS</span><span style="color:#2cee82;font-size:12px;font-weight:700;">✓ FREE</span></div>';
  html += '<div style="display:flex;justify-content:space-between;"><span style="color:#6b7a75;font-size:12px;">PRICE</span><span style="color:#fff;font-size:14px;font-weight:700;">₹0</span></div></div>';
  html += '<button onclick="closeModal()" style="width:100%;background:linear-gradient(135deg,#2cee82,#10b981);color:#000;border:none;padding:14px;border-radius:12px;font-weight:700;font-size:15px;cursor:pointer;">Enroll Free</button>';
  html += '</div></div>';
  var d = document.createElement('div'); d.id='batch-modal'; d.innerHTML=html;
  document.body.appendChild(d);
}
function closeModal(){ var m=document.getElementById('batch-modal'); if(m) m.remove(); }
</script>
</body></html>
