# Supabase project settings
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key
# Use the server-only service_role key for PHP writes and Storage uploads.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=studywinzo

# Admin login
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-long-random-password

# Wasmer sets PORT automatically; this is only a local fallback.
PORT=8080