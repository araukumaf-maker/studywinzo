.breadcrumb .current{color:#e2e8f0;font-weight:600}
.type-pill{padding:4px 10px;border-radius:20px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px}
.tp-note{background:rgba(59,130,246,.15);color:#60a5fa}
.tp-dpp{background:rgba(168,85,247,.15);color:#c084fc}
.tp-video{background:rgba(239,68,68,.15);color:#f87171}
