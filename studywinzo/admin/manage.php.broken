.input-radio-card{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:16px 12px;border:2px solid #1a2332;border-radius:16px;background:#070b14;cursor:pointer;transition:all .2s;text-align:center}
.input-radio-card:hover{border-color:rgba(59,130,246,.5);background:#0a1220}
