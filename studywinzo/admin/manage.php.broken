</main>

<style>
@keyframes slideIn{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}
</style>

<script>
function switchCtype(){
  var r = document.querySelector('input[name="ctype"]:checked');
  if (!r) return;
  var v = r.value;
  document.getElementById('fileField').style.display = (v==='note'||v==='dpp') ? 'block' : 'none';
  document.getElementById('videoField').style.display = (v==='video') ? 'block' : 'none';
  document.getElementById('linkField').style.display = (v==='link') ? 'block' : 'none';
}
switchCtype();
</script>
</body></html>
