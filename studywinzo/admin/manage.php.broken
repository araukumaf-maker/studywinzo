<?php
require_once 'config.php';
requireAdmin();

$type = $_GET['type'] ?? 'batch'; // batch | subject | chapter | content
$msg = ''; $err = '';

$institutions = getJSON('institutions.json', []);
$batches = getJSON('batches.json', []);
$subjects = getJSON('subjects.json', []);
$chapters = getJSON('chapters.json', []);
$content = getJSON('content.json', []);

$batchId = $_GET['batch'] ?? ($_POST['batch_id'] ?? '');
$subjectId = $_GET['subject'] ?? ($_POST['subject_id'] ?? '');
$chapterId = $_GET['chapter'] ?? ($_POST['chapter_id'] ?? '');

// =============== SAVE BATCH ===============
if ($_SERVER['REQUEST_METHOD']==='POST' && ($_POST['action'] ?? '')==='save_batch') {
    $id = trim($_POST['id'] ?? '');
    $name = trim($_POST['name'] ?? '');
    $subject = trim($_POST['subject'] ?? '');
    $desc = trim($_POST['description'] ?? '');
    $color = trim($_POST['color'] ?? '#2cee82');
    if (!$name) $err = 'Batch name required';
    else {
        $img = $_POST['existing_image'] ?? '';
        if (!empty($_FILES['image']['tmp_name'])) {
            $up = handleUpload('image', UPLOAD_BATCHES, ['jpg','jpeg','png','webp'], 5);
            if ($up['success']) $img = $up['filename'];
            else $err = 'Image: '.$up['error'];
        }
        if (!$err) {
            if ($id) {
                foreach ($batches as $i=>$b) if ($b['id']===$id) {
                    $batches[$i]['name']=$name; $batches[$i]['subject']=$subject;
                    $batches[$i]['description']=$desc; $batches[$i]['color']=$color; $batches[$i]['institutionId']=trim($_POST['institution_id'] ?? '');
                    if ($img) $batches[$i]['image']=$img;
                    break;
                }
                $msg = 'Batch updated successfully';
            } else {
                $batches[] = ['id'=>uid('b'),'institutionId'=>trim($_POST['institution_id'] ?? ''),'name'=>$name,'subject'=>$subject,'description'=>$desc,'color'=>$color,'image'=>$img,'created'=>date('Y-m-d H:i:s')];
                $msg = 'Batch added successfully';
            }
            saveJSON('batches.json', $batches);
        }
    }
}

// =============== SAVE SUBJECT ===============
if ($_SERVER['REQUEST_METHOD']==='POST' && ($_POST['action'] ?? '')==='save_subject') {
    $id = trim($_POST['id'] ?? ''); $name = trim($_POST['name'] ?? ''); $bid = trim($_POST['batch_id'] ?? '');
    $order = (int)($_POST['order'] ?? 0);
    if (!$name || !$bid) $err = 'Name and batch required';
    else {
        if ($id) { foreach ($subjects as $i=>$s) if ($s['id']===$id) { $subjects[$i]['name']=$name; $subjects[$i]['order']=$order; break; } $msg='Subject updated'; }
        else { $subjects[] = ['id'=>uid('s'),'batchId'=>$bid,'name'=>$name,'order'=>$order,'created'=>date('Y-m-d H:i:s')]; $msg='Subject added'; }
        saveJSON('subjects.json', $subjects);
    }
}

// =============== SAVE CHAPTER ===============
if ($_SERVER['REQUEST_METHOD']==='POST' && ($_POST['action'] ?? '')==='save_chapter') {
    $id = trim($_POST['id'] ?? ''); $name = trim($_POST['name'] ?? ''); $sid = trim($_POST['subject_id'] ?? '');
    $order = (int)($_POST['order'] ?? 0);
    if (!$name || !$sid) $err = 'Name and subject required';
    else {
        if ($id) { foreach ($chapters as $i=>$c) if ($c['id']===$id) { $chapters[$i]['name']=$name; $chapters[$i]['order']=$order; break; } $msg='Chapter updated'; }
        else { $chapters[] = ['id'=>uid('c'),'subjectId'=>$sid,'name'=>$name,'order'=>$order,'created'=>date('Y-m-d H:i:s')]; $msg='Chapter added'; }
        saveJSON('chapters.json', $chapters);
    }
}

// =============== SAVE CONTENT ===============
if ($_SERVER['REQUEST_METHOD']==='POST' && ($_POST['action'] ?? '')==='save_content') {
    $id = trim($_POST['id'] ?? ''); $chId = trim($_POST['chapter_id'] ?? '');
    $ctype = $_POST['ctype'] ?? 'note';
    $title = trim($_POST['title'] ?? ''); $description = trim($_POST['description'] ?? '');
    $videoUrl = trim($_POST['video_url'] ?? ''); $externalUrl = trim($_POST['external_url'] ?? '');
    $fileField = $ctype === 'dpp' ? 'dpp_file' : 'note_file';
    if (!$title || !$chId) $err = 'Title and chapter required';
    else {
        $item = ['id'=>$id ?: uid('ct'), 'chapterId'=>$chId, 'type'=>$ctype, 'title'=>$title, 'description'=>$description, 'video_url'=>$videoUrl, 'external_url'=>$externalUrl, 'file'=>'', 'updated'=>date('Y-m-d H:i:s')];
        if ($id) { foreach ($content as $c) if ($c['id']===$id) { $item['file']=$c['file']??''; $item['created']=$c['created']??date('Y-m-d H:i:s'); break; } }
        else $item['created'] = date('Y-m-d H:i:s');
        if (!empty($_FILES[$fileField]['tmp_name'])) {
            $dest = $ctype === 'dpp' ? UPLOAD_DPP : UPLOAD_NOTES;
            $up = handleUpload($fileField, $dest, ['pdf','doc','docx','zip','jpg','jpeg','png'], 30);
            if ($up['success']) { if (!empty($item['file']) && file_exists($dest.'/'.$item['file'])) @unlink($dest.'/'.$item['file']); $item['file']=$up['filename']; }
            else $err = 'File: '.$up['error'];
        }
        if (!$err) {
            $found = false;
            foreach ($content as $i=>$c) if ($c['id']===$item['id']) { $content[$i]=$item; $found=true; break; }
            if (!$found) $content[] = $item;
            saveJSON('content.json', $content);
            $msg = 'Content saved successfully';
        }
    }
}

// =============== DELETES ===============
if (isset($_GET['delete_batch'])) {
    $id = $_GET['delete_batch'];
    foreach ($batches as $b) if ($b['id']===$id && !empty($b['image'])) @unlink(UPLOAD_BATCHES.'/'.$b['image']);
    $batches = array_values(array_filter($batches, fn($b)=>$b['id']!==$id));
    saveJSON('batches.json', $batches);
    header('Location: manage.php?type=batch&d=1'); exit;
}
if (isset($_GET['delete_subject'])) {
    $id = $_GET['delete_subject'];
    $subjects = array_values(array_filter($subjects, fn($s)=>$s['id']!==$id));
    $chs = array_filter($chapters, fn($c)=>$c['subjectId']===$id);
    $chIds = array_column($chs, 'id');
    $chapters = array_values(array_filter($chapters, fn($c)=>$c['subjectId']!==$id));
    $content = array_values(array_filter($content, fn($c)=>!in_array($c['chapterId'], $chIds)));
    saveJSON('subjects.json', $subjects); saveJSON('chapters.json', $chapters); saveJSON('content.json', $content);
    header('Location: manage.php?type=subject&batch='.$batchId.'&d=1'); exit;
}
if (isset($_GET['delete_chapter'])) {
    $id = $_GET['delete_chapter'];
    $chapters = array_values(array_filter($chapters, fn($c)=>$c['id']!==$id));
    $content = array_values(array_filter($content, fn($c)=>$c['chapterId']!==$id));
    saveJSON('chapters.json', $chapters); saveJSON('content.json', $content);
    header('Location: manage.php?type=chapter&batch='.$batchId.'&subject='.$subjectId.'&d=1'); exit;
}
if (isset($_GET['delete_content'])) {
    $id = $_GET['delete_content'];
    foreach ($content as $c) if ($c['id']===$id) {
        if (!empty($c['file'])) foreach ([UPLOAD_NOTES,UPLOAD_DPP] as $d) if (file_exists($d.'/'.$c['file'])) @unlink($d.'/'.$c['file']);
        break;
    }
    $content = array_values(array_filter($content, fn($c)=>$c['id']!==$id));
    saveJSON('content.json', $content);
    header('Location: manage.php?type=content&batch='.$batchId.'&subject='.$subjectId.'&chapter='.$chapterId.'&d=1'); exit;
}

// =============== LOADERS ===============
$editBatch = $editSubject = $editChapter = $editContent = null;
if (isset($_GET['edit_batch'])) foreach ($batches as $b) if ($b['id']===$_GET['edit_batch']) $editBatch = $b;
if (isset($_GET['edit_subject'])) foreach ($subjects as $s) if ($s['id']===$_GET['edit_subject']) $editSubject = $s;
if (isset($_GET['edit_chapter'])) foreach ($chapters as $c) if ($c['id']===$_GET['edit_chapter']) $editChapter = $c;
if (isset($_GET['edit_content'])) foreach ($content as $c) if ($c['id']===$_GET['edit_content']) $editContent = $c;

$currentBatch = null;
foreach ($batches as $b) if ($b['id']===$batchId) $currentBatch = $b;
$currentSubject = null;
foreach ($subjects as $s) if ($s['id']===$subjectId) $currentSubject = $s;
$currentChapter = null;
foreach ($chapters as $c) if ($c['id']===$chapterId) $currentChapter = $c;

$subsForBatch = array_values(array_filter($subjects, fn($s)=>$s['batchId']===$batchId));
usort($subsForBatch, fn($a,$b)=>($a['order']??0)-($b['order']??0));
$chsForSubject = array_values(array_filter($chapters, fn($c)=>$c['subjectId']===$subjectId));
usort($chsForSubject, fn($a,$b)=>($a['order']??0)-($b['order']??0));
$itemsForChapter = array_values(array_filter($content, fn($x)=>$x['chapterId']===$chapterId));
usort($itemsForChapter, fn($a,$b)=>strcmp($b['created']??'', $a['created']??''));
?>
