<input type="color" name="color" value="<?= htmlspecialchars($editBatch['color'] ?? '#2cee82') ?>" style="width:56px;height:44px;border-radius:12px;border:2px solid #1a2332;background:transparent;cursor:pointer"/>
<span style="color:#64748b;font-size:12px">Batch theme</span>
</div>
</div>
</div>

<div style="display:flex;gap:10px;margin-top:8px">
<button type="submit" class="btn <?= $editBatch?'btn-purple':'' ?>">
